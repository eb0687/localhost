{
  "schema": "./schema.json",
  "servers": [
    {
      "host": "0.0.0.0",
      "ports": [8080],
      "server_name": ["localhost"],
      "client_max_body_size": 1048576,
      "error_pages": {
        "403": "./errors/403.html",
        "404": "./errors/404.html",
        "500": "./errors/500.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/readme",
          "root": "./README.md",
          "allowed_methods": ["GET"]
        },
        {
          "type": "file_server",
          "path": "/directory",
          "root": "./www",
          "allowed_methods": ["GET"],
          "directory_listing": true,
          "default_file": "index.html"
        }
      ]
    }
  ]
}
