{
  "servers": [
    {
      "host": "0.0.0.0",
      "ports": [8080],
      "server_name": ["localhost", "site1.local", "test.com"],
      "client_max_body_size": 1048576,
      "error_pages": {
        "400": "./errors/400.html",
        "403": "./errors/403.html",
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html",
        "504": "./errors/504.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/",
          "root": "./www",
          "allowed_methods": ["GET"],
          "directory_listing": false,
          "default_file": "index.html"
        },
        {
          "type": "file_server",
          "path": "/hello",
          "root": "./www/hello.txt",
          "allowed_methods": ["GET"]
        },
        {
          "type": "file_server",
          "path": "/errors",
          "root": "./errors",
          "allowed_methods": ["GET"],
          "directory_listing": false
        },
        {
          "type": "file_server",
          "path": "/upload",
          "root": "./uploads",
          "allowed_methods": ["GET", "POST", "DELETE"],
          "directory_listing": true
        },
        {
          "type": "cgi",
          "path": "/cgi",
          "root": "./cgi",
          "extension": ".sh",
          "interpreter": "/bin/bash"
        },
        {
          "type": "redirect",
          "path": "/redirect",
          "target": "http://localhost:8080/redirected"
        },
        {
          "type": "file_server",
          "path": "/redirected",
          "root": "./www/redirected.html",
          "allowed_methods": ["GET"]
        }
      ]
    },
    {
      "host": "0.0.0.0",
      "ports": [8080, 8021],
      "server_name": ["site2.local"],
      "client_max_body_size": 1048576,
      "error_pages": {
        "400": "./errors/400.html",
        "403": "./errors/403.html",
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html",
        "504": "./errors/504.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/hello",
          "root": "./www/hello.txt",
          "allowed_methods": ["GET"]
        }
      ]
    },
    {
      "host": "0.0.0.0",
      "ports": [8080],
      "server_name": ["small.local"],
      "client_max_body_size": 5,
      "error_pages": {
        "400": "./errors/400.html",
        "403": "./errors/403.html",
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html",
        "504": "./errors/504.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/hello",
          "root": "./www/hello.txt",
          "allowed_methods": ["GET"]
        },
        {
          "type": "file_server",
          "path": "/upload",
          "root": "./uploads",
          "allowed_methods": ["GET", "POST", "DELETE"],
          "directory_listing": true
        }
      ]
    },
    {
      "host": "0.0.0.0",
      "ports": [8080, 8080],
      "server_name": ["duplicate.local"],
      "client_max_body_size": 5,
      "error_pages": {
        "400": "./errors/400.html",
        "403": "./errors/403.html",
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html",
        "504": "./errors/504.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/hello",
          "root": "./www/hello.txt",
          "allowed_methods": ["GET"]
        }
      ]
    },
    {
      "host": "0.0.0.0",
      "ports": [8080],
      "server_name": ["bad.local"],
      "client_max_body_size": 5,
      "error_pages": {
        "400": "./errors/400.html",
        "403": "./errors/403.html",
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html",
        "504": "./errors/504.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/bad",
          "root": "./missing-folder",
          "allowed_methods": ["GET"]
        }
      ]
    }
  ]
}
