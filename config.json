{
  "schema": "./schema.json",
  "servers": [
    {
      "host": "0.0.0.0",
      "ports": [8080],
      "server_name": ["localhost", "site1.local"],
      "client_max_body_size": 1048576,
      "error_pages": {
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/",
          "root": "./",
          "allowed_methods": ["GET"],
          "directory_listing": true,
          "default_file": "index.html"
        },
        {
          "type": "file_server",
          "path": "/readme",
          "root": "./README.md",
          "allowed_methods": ["GET"]
        },
        {
          "type": "file_server",
          "path": "/upload",
          "root": "./uploads",
          "allowed_methods": ["GET", "POST", "DELETE"],
          "directory_listing": true
        }
      ]
    },
    {
      "host": "0.0.0.0",
      "ports": [8080],
      "server_name": ["site2.local"],
      "client_max_body_size": 1048576,
      "error_pages": {
        "404": "./errors/404.html",
        "405": "./errors/405.html",
        "413": "./errors/413.html",
        "500": "./errors/500.html"
      },
      "routes": [
        {
          "type": "file_server",
          "path": "/readme",
          "root": "./README.md",
          "allowed_methods": ["GET"]
        }
      ]
    }
  ]
}
